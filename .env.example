# === Steam Data Source ===
# API credentials will depend on the selected data source
STEAM_API_KEY=

# === Snowflake Infrastructure ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=steam_db
SNOWFLAKE_WAREHOUSE=steam_wh

# === dlt - Data Ingestion ===
SNOWFLAKE_LOADER_USER=dlt_user
SNOWFLAKE_LOADER_PASSWORD=
# Path to the private key file (keep it outside the repo). dlt reads the file.
SNOWFLAKE_LOADER_PRIVATE_KEY_PATH=
SNOWFLAKE_LOADER_ROLE=steam_loader

# === dbt - Data Transformation ===
SNOWFLAKE_TRANSFORMER_USER=dbt_user
SNOWFLAKE_TRANSFORMER_PASSWORD=
SNOWFLAKE_TRANSFORMER_ROLE=steam_transformer
DBT_TARGET=dev
DBT_SCHEMA=dbt_staging

# === Streamlit - Dashboard ===
SNOWFLAKE_REPORTER_USER=streamlit_user
SNOWFLAKE_REPORTER_PASSWORD=
SNOWFLAKE_REPORTER_ROLE=steam_reporter