Table dim_date {
  date_day date [pk, note: 'One Stockholm day']
  year int
  month int
  month_name varchar
  week_of_year int
  day_of_week int
  is_weekend boolean
}

Table dim_game {
  steam_appid int [pk, note: 'Steam id, one row per game, latest state']
  name varchar
  type varchar
  release_date date [note: 'NULL for unreleased games']
  release_year int
  release_date_text varchar
  required_age int
  metacritic_score int
  website varchar
  short_description varchar
  platform_windows boolean
  platform_mac boolean
  platform_linux boolean
  developers variant [note: 'list']
  publishers variant [note: 'list']
  genres variant [note: 'list, split later in the genre mart']
  genres_text varchar [note: 'for example Strategy, Simulation']
  categories variant [note: 'list']
  franchise varchar [note: 'NULL until the hand-made list exists']
}

Table fact_game_snapshot {
  steam_appid int [not null, ref: > dim_game.steam_appid]
  load_id varchar [not null, note: 'Which dlt run the row came from']
  snapshot_date date [not null, ref: > dim_date.date_day, note: 'Stockholm day of the run']
  collected_at_utc timestamp
  price_currency varchar
  price_initial decimal(10,2) [note: 'NULL = no price, never 0']
  price_final decimal(10,2)
  discount_percent int
  is_free boolean
  coming_soon boolean
  total_positive int [note: 'NULL before the review_summary runs']
  total_negative int
  counts_all_languages boolean [note: 'false before 2026-11-02']
  recent_positive int [note: 'NULL before the review_recent runs']
  recent_negative int
  player_count int [note: 'NULL = no data, 0 = real zero']
  has_player_data boolean
  collected_hour_local int [note: 'Stockholm hour of the player count']

  indexes {
    (steam_appid, load_id) [pk]
  }
}

Table mart_genre_comparison {
  genre varchar
  snapshot_date date
  game_count int
  avg_pct_positive decimal(5,1)
  avg_player_count decimal(12,1)
  avg_price_final decimal(10,2)

  Note: 'Mart, not part of the star. Built from the fact and dim_game by splitting dim_game.genres. Never add genres together, a game counts once per genre.'
}